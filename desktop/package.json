{
  "name": "summer-workbench-desktop",
  "productName": "Summer工作台",
  "version": "1.1.4",
  "description": "Summer 工作台纯本地桌面版",
  "private": true,
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "prepare-workbench": "node build-workbench.mjs",
    "dev": "npm run prepare-workbench && electron .",
    "dist": "npm run prepare-workbench && electron-builder"
  },
  "dependencies": {
    "argparse": "2.0.1",
    "builder-util-runtime": "9.2.3",
    "debug": "4.4.3",
    "electron-updater": "6.1.8",
    "fs-extra": "10.1.0",
    "graceful-fs": "4.2.11",
    "jsonfile": "6.2.1",
    "js-yaml": "4.3.2",
    "lazy-val": "1.0.5",
    "lodash.escaperegexp": "4.1.2",
    "lodash.isequal": "4.5.0",
    "ms": "2.1.3",
    "semver": "7.8.5",
    "sax": "1.6.1",
    "tiny-typed-emitter": "2.1.0",
    "universalify": "2.0.1"
  },
  "devDependencies": {
    "electron": "30.0.9",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "ai.summer.workbench",
    "artifactName": "Summer工作台-${version}-${os}-${arch}.${ext}",
    "files": ["main.mjs", "preload.mjs", "local-server.mjs", "package.json"],
    "extraResources": [{ "from": ".build/workbench", "to": "workbench" }],
    "afterPack": "after-pack.mjs",
    "publish": [{ "provider": "github", "owner": "wangxiujuan626-bit", "repo": "summer-workbench" }],
    "mac": {
      "category": "public.app-category.productivity",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "target": ["dmg", "zip"]
    },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Summer工作台"
    }
  }
}
